# Ollama Modelfile for the fine-tuned SPIDER reviewer.
# convert_to_ollama.sh copies this file next to the GGUF and fills in FROM; edit by hand if you do it manually:
#   ollama create spider-reviewer -f training/Modelfile
FROM ./spider-reviewer.Q4_K_M.gguf

# Same Llama 3 chat format the model was trained on (see render() in train_qlora.py).
TEMPLATE """{{ if .System }}<|start_header_id|>system<|end_header_id|>

{{ .System }}<|eot_id|>{{ end }}{{ if .Prompt }}<|start_header_id|>user<|end_header_id|>

{{ .Prompt }}<|eot_id|>{{ end }}<|start_header_id|>assistant<|end_header_id|>

{{ .Response }}<|eot_id|>"""

PARAMETER stop "<|start_header_id|>"
PARAMETER stop "<|end_header_id|>"
PARAMETER stop "<|eot_id|>"
PARAMETER temperature 0
# 300-line chunks + notes can pass Ollama's default context; 4096 covers a chunk (needs ~1 GB extra memory)
PARAMETER num_ctx 4096
