{"id": "S012", "owasp": "A07:2021 - Identification and Authentication Failures", "cwe": "CWE-798", "language": "javascript", "description": "Hard-coded admin password check", "vulnerable_code": "if (pass === 'admin123') grant(user);", "fixed_code": "if (await bcrypt.compare(pass, user.hash)) grant(user);", "source": "original, written for this project", "license": "MIT"}
