{"id": "S001", "owasp": "A01:2021 - Broken Access Control", "cwe": "CWE-639", "language": "python", "description": "Insecure direct object reference: any user can read any invoice by id", "vulnerable_code": "@app.route('/invoice/<int:i>')\ndef invoice(i):\n    return db.get_invoice(i)", "fixed_code": "@app.route('/invoice/<int:i>')\n@login_required\ndef invoice(i):\n    inv = db.get_invoice(i)\n    if inv.owner_id != current_user.id:\n        abort(403)\n    return inv", "source": "original, written for this project", "license": "MIT"}
{"id": "S002", "owasp": "A01:2021 - Broken Access Control", "cwe": "CWE-22", "language": "python", "description": "Path traversal in file download", "vulnerable_code": "def download(name):\n    return open('/srv/files/' + name, 'rb').read()", "fixed_code": "import os\ndef download(name):\n    base = os.path.realpath('/srv/files')\n    path = os.path.realpath(os.path.join(base, name))\n    if not path.startswith(base + os.sep):\n        raise PermissionError(name)\n    return open(path, 'rb').read()", "source": "original, written for this project", "license": "MIT"}
{"id": "S003", "owasp": "A02:2021 - Cryptographic Failures", "cwe": "CWE-327", "language": "python", "description": "MD5 used for password hashing", "vulnerable_code": "import hashlib\ndef hash_pw(pw):\n    return hashlib.md5(pw.encode()).hexdigest()", "fixed_code": "import bcrypt\ndef hash_pw(pw):\n    return bcrypt.hashpw(pw.encode(), bcrypt.gensalt())", "source": "original, written for this project", "license": "MIT"}
{"id": "S004", "owasp": "A02:2021 - Cryptographic Failures", "cwe": "CWE-798", "language": "python", "description": "Hard-coded API key", "vulnerable_code": "API_KEY = 'sk-live-1234567890abcdef'", "fixed_code": "import os\nAPI_KEY = os.environ['API_KEY']", "source": "original, written for this project", "license": "MIT"}
{"id": "S005", "owasp": "A02:2021 - Cryptographic Failures", "cwe": "CWE-295", "language": "python", "description": "TLS verification disabled", "vulnerable_code": "r = requests.get(url, verify=False)", "fixed_code": "r = requests.get(url, timeout=10)", "source": "original, written for this project", "license": "MIT"}
{"id": "S006", "owasp": "A03:2021 - Injection", "cwe": "CWE-89", "language": "python", "description": "SQL injection via string concatenation", "vulnerable_code": "cur.execute(\"SELECT * FROM users WHERE name = '\" + name + \"'\")", "fixed_code": "cur.execute('SELECT * FROM users WHERE name = ?', (name,))", "source": "original, written for this project", "license": "MIT"}
{"id": "S007", "owasp": "A03:2021 - Injection", "cwe": "CWE-78", "language": "python", "description": "OS command injection through shell=True", "vulnerable_code": "subprocess.run('ping -c 1 ' + host, shell=True)", "fixed_code": "subprocess.run(['ping', '-c', '1', host], check=True)", "source": "original, written for this project", "license": "MIT"}
