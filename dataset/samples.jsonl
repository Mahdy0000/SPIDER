{"id": "S016", "owasp": "A10:2021 - Server-Side Request Forgery", "cwe": "CWE-918", "language": "python", "description": "SSRF: server fetches a user-supplied URL", "vulnerable_code": "def preview(url):\n    return requests.get(url).text", "fixed_code": "from urllib.parse import urlparse\nALLOWED = {'example.com'}\ndef preview(url):\n    if urlparse(url).hostname not in ALLOWED:\n        raise ValueError('host not allowed')\n    return requests.get(url, timeout=5, allow_redirects=False).text", "source": "original, written for this project", "license": "MIT"}
